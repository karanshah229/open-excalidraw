{
  "name": "agentic-whiteboard-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "dev": "pnpm dev:whiteboard",
    "dev:all": "pnpm --parallel --filter @agentic-whiteboard/whiteboard --filter @agentic-whiteboard/mcp dev",
    "dev:whiteboard": "pnpm --filter @agentic-whiteboard/whiteboard dev",
    "dev:mcp": "pnpm --filter @agentic-whiteboard/mcp dev",
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:collab": "pnpm dlx tsx tests/collab-edge-cases.test.ts",
    "test:e2e:collab": "node tests/run-regression-tests.mjs --test=e2e-collab-suite.mjs",
    "test:e2e:chaos": "node tests/run-regression-tests.mjs --test=collab-chaos-live.test.mjs",
    "test:e2e:visual": "node tests/run-regression-tests.mjs --test=e2e-visual-screenshots.mjs",
    "test:e2e:metadata": "pnpm --filter @agentic-whiteboard/whiteboard build && node tests/metadata-assets.test.mjs",
    "test:network": "node tests/run-regression-tests.mjs --test=network-lifecycle.test.mjs",
    "test:repro": "node tests/run-regression-tests.mjs --test=repro-user-str.mjs",
    "test:inactive": "node tests/run-regression-tests.mjs --test=inactive-tab-presence-cursor.test.mjs",
    "test:zoom": "node tests/run-regression-tests.mjs --test=board-auto-zoom-center.test.mjs",
    "test:solo": "node tests/run-regression-tests.mjs --test=solo-no-collab-banner.test.mjs",
    "test:undo": "node tests/run-regression-tests.mjs --test=incognito-undo-beforeunload.test.mjs",
    "test:collab:undo": "node tests/run-regression-tests.mjs --test=collab-undo-resurrect.test.mjs",
    "test:flash": "node tests/run-regression-tests.mjs --test=delete-all-reload-flash.test.mjs",
    "test:owner": "node tests/run-regression-tests.mjs --test=unauthenticated-owner-hidden.test.mjs",
    "test:solo:undo": "node tests/run-regression-tests.mjs --test=solo-delete-collab-undo.test.mjs",
    "test:collab:ops": "node tests/run-regression-tests.mjs --test=collab-undo-further-ops.test.mjs",
    "test:mcp": "pnpm dlx tsx tests/mcp-tools-suite.test.ts",
    "test:mcp:e2e": "node tests/run-regression-tests.mjs --test=mcp-live-e2e.test.mjs",
    "test:dropdown": "node tests/run-regression-tests.mjs --test=create-board-modal-dropdown-scroll.test.mjs",
    "test:images": "node tests/image-persistence.test.mjs",
    "test:images:cloud": "pnpm --filter @agentic-whiteboard/functions build && firebase emulators:exec --only auth,firestore,storage,database,functions --project demo-image-persistence --config image-persistence.firebase.json 'node tests/image-persistence.test.mjs --cloud'",
    "check:images:deployment": "python3 tests/image-deployment-status.py",
    "test:images:formats": "node tests/image-formats.test.mjs",
    "test:images:formats:cloud": "pnpm --filter @agentic-whiteboard/functions build && firebase emulators:exec --only auth,firestore,storage,database,functions --project demo-image-persistence --config image-persistence.firebase.json 'node tests/image-formats.test.mjs --cloud'",
    "test:images:formats:dev": "node tests/image-formats.test.mjs --live=development",
    "test:images:formats:prod-bundle": "node tests/image-formats.test.mjs --production-bundle",
    "test:sync:deleted-project": "pnpm --filter @agentic-whiteboard/functions build && firebase emulators:exec --only auth,firestore,storage,database,functions --project demo-image-persistence --config image-persistence.firebase.json 'node tests/deleted-project-sync.test.mjs'",
    "test:e2e:projects": "node tests/run-projects-e2e.mjs",
    "test:e2e:regression": "node tests/run-regression-tests.mjs",
    "test": "node tests/run-all-tests.mjs",
    "test:slides": "pnpm dlx tsx tests/slides-model.test.ts && node tests/run-slides-tests.mjs",
    "test:slides:prod": "pnpm --filter @agentic-whiteboard/whiteboard exec vite build --mode e2e && node tests/slides-production.test.mjs",
    "test:slides:notes": "pnpm --filter @agentic-whiteboard/functions build && firebase emulators:exec --only auth,firestore,storage,database,functions --project demo-image-persistence --config image-persistence.firebase.json 'node tests/slide-notes-access.test.mjs'"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.8",
    "puppeteer-core": "^25.12.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1"
  }
}
