{
  "name": "agentic-whiteboard-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "dev": "pnpm dev:whiteboard",
    "dev:all": "pnpm --parallel --filter @agentic-whiteboard/whiteboard --filter @agentic-whiteboard/mcp dev",
    "dev:whiteboard": "pnpm --filter @agentic-whiteboard/whiteboard dev",
    "dev:mcp": "pnpm --filter @agentic-whiteboard/mcp dev",
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:collab": "pnpm dlx tsx tests/collab-edge-cases.test.ts",
    "test:e2e:collab": "node tests/e2e-collab-suite.mjs",
    "test:e2e:chaos": "node tests/collab-chaos-live.test.mjs",
    "test:e2e:visual": "node tests/e2e-visual-screenshots.mjs",
    "test:network": "node tests/network-lifecycle.test.mjs",
    "test:repro": "node tests/repro-user-str.mjs",
    "test:inactive": "node tests/inactive-tab-presence-cursor.test.mjs",
    "test:zoom": "node tests/board-auto-zoom-center.test.mjs",
    "test:solo": "node tests/solo-no-collab-banner.test.mjs",
    "test:undo": "node tests/incognito-undo-beforeunload.test.mjs",
    "test:collab:undo": "node tests/collab-undo-resurrect.test.mjs",
    "test:flash": "node tests/delete-all-reload-flash.test.mjs",
    "test:owner": "node tests/unauthenticated-owner-hidden.test.mjs",
    "test:solo:undo": "node tests/solo-delete-collab-undo.test.mjs",
    "test:collab:ops": "node tests/collab-undo-further-ops.test.mjs",
    "test:mcp": "pnpm dlx tsx tests/mcp-tools-suite.test.ts",
    "test:mcp:e2e": "node tests/mcp-live-e2e.test.mjs",
    "test:dropdown": "node tests/create-board-modal-dropdown-scroll.test.mjs",
    "test:freemium": "pnpm --filter @agentic-whiteboard/functions build && node tests/run-freemium-tests.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.8",
    "puppeteer-core": "^25.12.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1"
  }
}
