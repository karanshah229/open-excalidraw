# Firebase Project Configuration
# Set these according to your environment (development vs production)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_URL=
# Must match the deployed SYNC_ACCESS_FUNCTION_REGION. No implicit region
# fallback is used because a wrong endpoint can make sharing fail silently.
VITE_FIREBASE_SYNC_ACCESS_FUNCTION_REGION=
# Optional: Set to 'true' to use local Firebase Emulators instead of cloud
# VITE_USE_FIREBASE_EMULATOR=true

# Firebase App Check (reCAPTCHA v3)
# 1. Register Web App in Firebase Console -> App Check -> Apps -> reCAPTCHA v3
# 2. Add public Site Key here
VITE_RECAPTCHA_SITE_KEY=
# Optional: explicitly provide a debug token UUID for local development
# VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=
