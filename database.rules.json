{
  "rules": {
    "boards": {
      "$boardId": {
        ".read": "auth != null",
        "elements": {
          ".write": "auth != null",
          "$elementId": {
            ".write": "auth != null",
            ".validate": "!newData.exists() || (newData.hasChildren(['id', 'version', 'versionNonce', 'data']) && newData.child('data').isString() && newData.child('data').val().length < 262144)"
          }
        },
        "meta": {
          ".write": "auth != null"
        }
      }
    },
    "presence": {
      "$boardId": {
        ".read": "auth != null",
        "$sessionId": {
          ".write": "auth != null",
          ".validate": "!newData.exists() || newData.hasChildren(['userId', 'sessionId', 'displayName', 'color', 'lastSeen'])"
        }
      }
    }
  }
}
